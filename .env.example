# ─── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1

# ─── ElevenLabs ──────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# VOICE_MODE: "multilingual" (Option 1 MVP) or "per_language" (Option 2)
VOICE_MODE=multilingual

# Option 1 — single multilingual voice
ELEVENLABS_VOICE_ID_MULTILINGUAL=your-multilingual-voice-id-here

# Option 2 — per-language voices (fill if VOICE_MODE=per_language)
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_HI=
ELEVENLABS_VOICE_ID_GU=

ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ─── Twilio ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACyour-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Server ───────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PUBLIC_BASE_URL=https://your-ngrok-or-domain.com

# ─── Language Detection ───────────────────────────────────
DEFAULT_LANGUAGE=en
# Minimum confidence to trust langdetect (0.0-1.0)
LANGDETECT_MIN_CONFIDENCE=0.70
# Minimum confidence to update conversation language
LANGUAGE_SWITCH_CONFIDENCE=0.80
# Consecutive turns before language switch is committed
LANGUAGE_SWITCH_TURNS=2
